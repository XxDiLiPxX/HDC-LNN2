# HDC-LNN Environment Configuration Template
# Copy this file to .env if you wish to override runtime defaults.
#
# Defaults work out-of-the-box for all local benchmarks, test runs, and CLI modes.

# Interactive Dashboard Host & Port
HDC_LNN_HOST=127.0.0.1
HDC_LNN_PORT=8050

# Log Level: DEBUG, INFO, WARNING, ERROR
HDC_LNN_LOG_LEVEL=INFO

# Random Seed for Evaluation Reproducibility (Seeds: 42, 123, 456, 789)
HDC_LNN_SEED=42

# Default Path for SIEM Alert Log Output
HDC_LNN_ALERT_LOG=soar_alerts.log
